# ─────────────────────────────────────────────
# FUYL Assessment — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ─────────────────────────────────────────────

# MongoDB (this app's own database)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/?retryWrites=true&w=majority
MONGODB_DB=fuyl_assessment

# Signs session + admin cookies. 32+ random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Public URL of this app (used in emailed report links)
APP_URL=http://localhost:3002

# FUYL Shopify storefront — product + ingredient data are synced from here
FUYL_STORE_URL=https://fuyl.in
FUYL_PRODUCT_HANDLE=fuyl-complete

# Email (report delivery) over SMTP. Without SMTP_HOST, emails are skipped
# and a one-line notice is logged (never the email body).
# Port 465 = implicit TLS; 587 = STARTTLS (TLS is required — plain text is refused).
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true   # only needed to force implicit TLS on a non-465 port
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=FUYL <hello@fuyl.in>

# Protects the scheduled sync endpoint (send as Authorization: Bearer <secret>)
CRON_SECRET=

# Local testing only. Leave unset in production: the public assessment stays
# closed until a reviewed knowledge-base version is published from /admin.
# ALLOW_UNPUBLISHED_KB=true
