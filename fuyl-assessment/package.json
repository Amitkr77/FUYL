{
  "name": "fuyl-assessment",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:preview": "tsx scripts/sync-preview.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "admin:create": "tsx --conditions=react-server --env-file=.env.local scripts/create-admin.ts",
    "test:e2e": "next build && playwright test",
    "check:env": "tsx --conditions=react-server --env-file=.env.local scripts/check-env.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.10.0",
    "lenis": "^1.1.20",
    "lucide-react": "^0.469.0",
    "mongoose": "^8.9.5",
    "motion": "^12.4.7",
    "next": "16.2.9",
    "node-html-parser": "^6.1.13",
    "nodemailer": "^6.9.16",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/smtp-server": "^3.5.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "mongodb-memory-server": "^10.1.2",
    "smtp-server": "^3.13.6",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
